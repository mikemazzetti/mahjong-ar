{
  "name": "mahjong-ar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "copy-ort": "mkdir -p public/ort && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.wasm node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.mjs public/ort/",
    "postinstall": "npm run copy-ort",
    "dev:http": "VITE_HTTP=1 vite --host --port 5174",
    "preview:http": "VITE_HTTP=1 vite preview --host --port 4174",
    "tunnel": "cloudflared tunnel --url https://localhost:5173 --no-tls-verify"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  }
}
